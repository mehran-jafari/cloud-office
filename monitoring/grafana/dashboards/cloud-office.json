  "panels": [
    {
      "title": "HTTP requests per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(cloud_office_http_requests_total[5m]))", "legendFormat": "requests/s"}]
    },
    {
      "title": "5xx errors per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(cloud_office_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx/s"}]
    },
    {
      "title": "P95 request latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(cloud_office_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}]
    },
    {
      "title": "Container memory",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum(container_memory_working_set_bytes) by (name)", "legendFormat": "{{name}}"}]
    }
  ],
