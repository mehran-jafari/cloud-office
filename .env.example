# Local Docker test stack — copy to .env before running docker compose
POSTGRES_DB=cloud_office
POSTGRES_USER=cloud_office
POSTGRES_PASSWORD=change-this-local-password
DATABASE_NAME=cloud_office
DATABASE_USER=cloud_office
DATABASE_PASSWORD=change-this-local-password
DATABASE_HOST=db
DATABASE_PORT=5432
REDIS_URL=redis://redis:6379/0
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
USE_POSTGRES=1
REFRESH_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SESSION_COOKIE_SECURE=0
# production پشت پروکسی TLS: =1 (فقط اگر پروکسی هدر X-Forwarded-Proto را بازنویسی می‌کند)
TRUST_PROXY_SSL_HEADER=0
SECURE_SSL_REDIRECT=1
# dev server (pnpm dev) روی دامنه/IP دیگر: VITE_ALLOWED_HOSTS=dev.example.com
# VITE_ALLOWED_HOSTS=
ONLYOFFICE_URL=http://onlyoffice
ONLYOFFICE_CALLBACK_SECRET=local-onlyoffice-callback-secret-change-me
PUBLIC_APP_URL=http://localhost:3000

# MinIO / S3-compatible storage
USE_S3=1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
AWS_STORAGE_BUCKET_NAME=cloud-office
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_QUERYSTRING_AUTH=1
AWS_QUERYSTRING_EXPIRE=900

# OpenAI-compatible AI provider; leave AI_API_KEY empty for local fallback
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBED_MODEL=text-embedding-3-small
AI_STT_MODEL=whisper-1
METRICS_TOKEN=

# Optional monitoring profile: Prometheus, Grafana, Loki, Promtail, cAdvisor
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
# Choose alertmanager.telegram.yml or alertmanager.slack.yml
ALERTMANAGER_CONFIG=alertmanager.telegram.yml
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=alerts

# Backup and disaster recovery
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=14
# Optional off-site S3-compatible destination; leave empty for local-only test backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
RESTORE_DRILL_PROJECT=cloud-office-staging-drill
RESTORE_DRILL_BACKEND_PORT=18000
RESTORE_DRILL_MINIO_API_PORT=19000
RESTORE_DRILL_MINIO_CONSOLE_PORT=19001

CREATE_SUPERUSER=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
# رمز ادمین را حتماً خودتان بگذارید (حداقل ۱۲ کاراکتر)؛ خالی = ادمین ساخته نمی‌شود
DJANGO_SUPERUSER_PASSWORD=

# Email (optional — for notifications)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Cloud Office <noreply@example.com>
# NOTIFY_EMAIL_ON_ALL=0
