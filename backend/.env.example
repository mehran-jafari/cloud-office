DJANGO_DEBUG=1
# Leave REDIS_URL empty for InMemoryChannelLayer (no Redis needed for local dev)
# REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=0
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
USE_X_FORWARDED_HOST=0
# فقط پشت reverse proxy مورد اعتماد (TLS) که X-Forwarded-Proto را بازنویسی می‌کند، =1 کنید
TRUST_PROXY_SSL_HEADER=0
# با DEBUG=0 پیش‌فرض 1؛ /api/health/ همیشه از ریدایرکت معاف است
# SECURE_SSL_REDIRECT=1
USE_POSTGRES=0
DATABASE_NAME=cloud_office
DATABASE_USER=cloud_office
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# OnlyOffice Document Server integration (optional)
ONLYOFFICE_URL=http://localhost:8080
APP_PUBLIC_URL=http://127.0.0.1:8000
ONLYOFFICE_CALLBACK_SECRET=replace-with-a-long-random-callback-secret
# میزبان‌های اضافه‌ای که Document Server فایل ذخیره‌شده را از آن‌ها می‌دهد (با کاما)
ONLYOFFICE_ALLOWED_HOSTS=
EDITOR_SIGNING_SALT=cloud-office-editor-v1
EDITOR_URL_TTL_SECONDS=300
EDITOR_MAX_DOWNLOAD_BYTES=104857600

# Production must set:
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<at-least-40-random-chars>
# DJANGO_ALLOWED_HOSTS=api.example.com
# USE_POSTGRES=1
# REDIS_URL=redis://127.0.0.1:6379/0

# AI — OpenAI-compatible (optional; without key local fallback is used)
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBED_MODEL=text-embedding-3-small
# AI_STT_MODEL=whisper-1
# timeout پاسخ خودکار پشتیبانی (ثانیه)
# SUPPORT_AI_TIMEOUT=20
# آدرس عمومی برنامه برای نصب‌کننده Desk (production: حتماً تنظیم شود)
# PUBLIC_APP_URL=https://office.example.com
